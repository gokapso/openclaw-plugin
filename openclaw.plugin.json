{
  "id": "kapso-whatsapp",
  "kind": "channel",
  "channels": [
    "kapso-whatsapp"
  ],
  "skills": [
    "./skills"
  ],
  "name": "Kapso WhatsApp",
  "description": "Official Kapso WhatsApp channel plugin for OpenClaw.",
  "version": "0.1.2",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelEnvVars": {
    "kapso-whatsapp": [
      "KAPSO_API_KEY",
      "KAPSO_PHONE_NUMBER_ID",
      "KAPSO_WEBHOOK_SECRET",
      "KAPSO_BASE_URL",
      "KAPSO_WEBHOOK_PATH",
      "KAPSO_BOT_USERNAME"
    ]
  },
  "channelConfigs": {
    "kapso-whatsapp": {
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "apiKey": {
            "type": "string"
          },
          "phoneNumberId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "webhookSecret": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "webhookPath": {
            "type": "string"
          },
          "defaultTo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "dmSecurity": {
            "enum": [
              "open",
              "allowlist",
              "disabled"
            ]
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accounts": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "uiHints": {
        "apiKey": {
          "label": "Kapso API key",
          "sensitive": true
        },
        "webhookSecret": {
          "label": "Webhook secret",
          "sensitive": true
        },
        "phoneNumberId": {
          "label": "WhatsApp phone number ID"
        },
        "baseUrl": {
          "label": "Kapso proxy URL"
        },
        "webhookPath": {
          "label": "Webhook path"
        }
      }
    }
  }
}
